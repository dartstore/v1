# ──────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Comma-separated allowlist of browser origins.
# Entries beginning with "*." are treated as subdomain wildcards.
# The default below reproduces the behaviour that was previously
# hardcoded in src/main.ts.
CORS_ORIGINS=http://localhost:3000,*.localhost:3000

# ──────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/dbname?schema=public

# ──────────────────────────────────────────────────────────────
# Security — REQUIRED. The application will refuse to boot without these.
# ──────────────────────────────────────────────────────────────

# Signs session JWTs. Must be identical across all instances.
# Rotating this invalidates every active session.
# Generate: openssl rand -base64 48
JWT_SECRET=

# HMAC key for the multi-step registration flow signature.
# Rotating this invalidates registration flows already in progress.
# Generate: openssl rand -base64 48
FLOW_SECRET=

# ──────────────────────────────────────────────────────────────
# Payments — encryption at rest
# ──────────────────────────────────────────────────────────────

# Root key (KEK). MUST decode to exactly 32 bytes from base64.
# Per-store data keys (DEKs) are derived from this via HKDF-SHA256,
# so this value is never used directly to encrypt tenant data.
# Losing it makes every stored credential permanently unrecoverable.
# Generate: openssl rand -base64 32
PAYMENT_ENCRYPTION_KEY=

# Version number stamped into every envelope this key produces.
# Increment only as part of a deliberate key rotation.
PAYMENT_ENCRYPTION_KEY_VERSION=1

# Optional. During a rotation, set these to the retired key so that
# ciphertext written before the rotation remains decryptable.
# PAYMENT_ENCRYPTION_KEY_PREVIOUS=
# PAYMENT_ENCRYPTION_KEY_PREVIOUS_VERSION=

# ──────────────────────────────────────────────────────────────
# Cloudflare R2 (existing — not validated at boot in Phase 0)
# ──────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
